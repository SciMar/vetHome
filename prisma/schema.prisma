// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "./erd.svg"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  USER
  VETERINARIAN
  SUPER_ADMIN
}

enum CitaStatus {
  PENDIENTE
  CONFIRMADA
  COMPLETADA
  CANCELADA
}

// ============================================
// MODELOS
// ============================================

model Usuario {
  id        String   @id @default(cuid())
  email     String   @unique
  nombre    String
  telefono  String?
  direccion String?
  password  String
  role      UserRole @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  veterinario   Veterinario?
  mascotas      Mascota[]
  citas         Cita[]
  calificaciones Calificacion[]

  @@index([email])
  @@index([role])
}

enum VetEstado {
  PENDIENTE
  APROBADO
  RECHAZADO
}

model Veterinario {
  id                 String    @id @default(cuid())
  userId             String    @unique
  cedula             String    @unique
  tarjetaProfesional String?
  calificacionPromedio Float   @default(0)
  estado             VetEstado @default(PENDIENTE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuario        Usuario      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinicas       VetClinica[]
  citas          Cita[]
  calificaciones Calificacion[]

  @@index([cedula])
}

model Clinica {
  id        String  @id @default(cuid())
  nombre    String
  direccion String
  telefono  String?
  horario   String?
  latitud   Float?
  longitud  Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  veterinarios VetClinica[]

  @@index([nombre])
}

model VetClinica {
  id       String @id @default(cuid())
  vetId    String
  clinicaId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  veterinario Veterinario @relation(fields: [vetId], references: [id], onDelete: Cascade)
  clinica    Clinica @relation(fields: [clinicaId], references: [id], onDelete: Cascade)

  @@unique([vetId, clinicaId])
  @@index([vetId])
  @@index([clinicaId])
}

model Mascota {
  id              String    @id @default(cuid())
  userId          String
  nombre          String
  especie         String
  raza            String?
  fechaNacimiento DateTime?
  peso            Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuario        Usuario        @relation(fields: [userId], references: [id], onDelete: Cascade)
  historiaMedica HistoriaMedica?
  citas          Cita[]

  @@index([userId])
  @@index([especie])
}

model HistoriaMedica {
  id        String @id @default(cuid())
  mascotaId String @unique
  vacunas   String? // JSON o texto con historial de vacunas
  alergias  String?
  condiciones String? // condiciones médicas preexistentes
  notas     String? // notas generales del historial

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  mascota Mascota @relation(fields: [mascotaId], references: [id], onDelete: Cascade)

  @@index([mascotaId])
}

model Cita {
  id        String @id @default(cuid())
  usuarioId String
  vetId     String
  mascotaId String
  fecha     DateTime
  status    CitaStatus @default(PENDIENTE)
  notas     String? // notas de la cita
  diagnostico String? // diagnóstico del veterinario

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  veterinario Veterinario @relation(fields: [vetId], references: [id], onDelete: Restrict)
  mascota Mascota @relation(fields: [mascotaId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([vetId])
  @@index([mascotaId])
  @@index([fecha])
  @@index([status])
}

model Calificacion {
  id        String @id @default(cuid())
  usuarioId String
  vetId     String
  puntuacion Int // 1-5
  comentario String?
  fecha     DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  veterinario Veterinario @relation(fields: [vetId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, vetId]) // Un usuario solo califica una vez por vet
  @@index([usuarioId])
  @@index([vetId])
}